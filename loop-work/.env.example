# Copy this file to .env and fill in the keys (all free).
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pexels stock photos + videos: https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional. Only needed if you want 1 short AI video clip.
# Free key: https://enter.pollinations.ai
POLLINATIONS_KEY=

# Optional override. Default is gemini-2.5-flash (free).
# If a model 404s, try: gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Voice (free Microsoft Edge TTS)
# Male: en-US-AndrewNeural
# Female: en-US-AriaNeural
# Indian English: en-IN-PrabhatNeural  or  en-IN-NeerjaNeural
VOICE=en-US-AndrewNeural
