      "position": [
        4360,
        480
      ]
    },
    {
      "parameters": {
        "url": "={ 'https://api.pexels.com/v1/search?query=' + encodeURIComponent($('10. Loop scenes').item.json.stock_query || 'golden hour office') + '&orientation=portrait&per_page=5' }",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $env.PEXELS_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "cd029",
      "name": "14. Pexels photo search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3800,
        720
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "u",
              "name": "mediaUrl",
              "value": "={{ $json.photos[0].src.portrait || $json.photos[0].src.large }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "cd030",
      "name": "14b. Pick photo URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        4080,
        720
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.mediaUrl }}",
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "cd031",
      "name": "14c. Download stock photo",
      "type": "n8n-nodes-base.httpRequest",
